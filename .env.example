# このファイルを .env にコピーして使う（cp .env.example .env）

# ローカルの PostgreSQL（docker compose）のホスト側ポート
# PC で別の PostgreSQL が動いていてポートが衝突する場合は変更し、下の DATABASE_URL と .env.test.local も合わせる
POSTGRES_PORT=55432

# 開発用DB（docker compose の nipo_dev）
DATABASE_URL="postgresql://nipo:nipo@localhost:55432/nipo_dev"

# 1 インスタンスあたりの DB 接続数の上限（任意、既定 10）
# 本番では「Cloud Run の最大インスタンス数 × この値」が Cloud SQL の接続上限（max_connections）を超えないように設定する
# DATABASE_POOL_MAX=10
